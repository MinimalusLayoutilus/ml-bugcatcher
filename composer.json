{
    "name": "mnhcc/ml-bugcatcher",
    "version": "0.9.0",
    "description": "Minimalus Layoutilus — error handler, event system and exception classes",
    "type": "library",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Michael Hegenbarth (carschrotter)",
            "email": "mnh@mn-hegenbarth.de"
        }
    ],
    "require": {
        "php": ">=5.4",
        "mnhcc/ml-core": "^0.9",
        "kint-php/kint": "^4.0",
        "firephp/firephp-core": "~0.3"
    },
    "autoload": {
        "classmap": [
            "classes/",
            "interfaces/",
            "traits/"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^5.7"
    },
    "repositories": [
        {"type": "path", "url": "../ml-core"}
    ],
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "dev"
}

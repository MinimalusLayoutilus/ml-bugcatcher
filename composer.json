{
    "name": "mnhcc/ml-bugcatcher",
    "description": "Minimalus Layoutilus — error/exception handler with debug overlay and typed exception hierarchy",
    "type": "library",
    "license": "LGPL-2.1-only",
    "keywords": ["error-handler", "exceptions", "debug", "framework"],
    "homepage": "https://github.com/carschrotter/ml-bugcatcher",
    "authors": [
        {
            "name": "Michael Hegenbarth (carschrotter)",
            "email": "mnh@mn-hegenbarth.de",
            "homepage": "https://github.com/carschrotter",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/carschrotter/ml-bugcatcher/issues",
        "source": "https://github.com/carschrotter/ml-bugcatcher"
    },
    "require": {
        "php": ">=5.4",
        "mnhcc/ml-core": "^1.0",
        "kint-php/kint": "^4.0",
        "firephp/firephp-core": "~0.3"
    },
    "autoload": {
        "classmap": [
            "classes/",
            "interfaces/",
            "traits/"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "mnhcc-ml": {
            "register": true
        }
    }
}
